# Copiar a .env y completar. Nunca commitear el .env real.

# Project Settings -> API -> Project URL
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Project Settings -> API -> service_role key (secreta — bypassa RLS,
# jamás usarla en el navegador, solo acá en el server).
SUPABASE_SERVICE_ROLE_KEY=

# Cada cuántos minutos revisa si hay recordatorios para mandar.
CHECK_INTERVAL_MINUTES=5

# URL pública donde corre la app. La usan los dos servers: payments.js
# para volver acá después de pagar, index.js para armar el link de
# "cancelá tu turno" que va en el WhatsApp de confirmación.
APP_URL=http://localhost:8080

# --- Servidor de pagos (payments.js) ---

# Dashboard de Mercado Pago -> Tus integraciones -> credenciales.
# Empieza con APP_USR- (producción) o TEST- (prueba). SECRETA — nunca
# en el navegador, solo acá.
MP_ACCESS_TOKEN=

# Puerto donde escucha el servidor de pagos.
PAYMENTS_PORT=3001

# URL pública donde Mercado Pago puede alcanzar ESTE servidor para
# mandar la confirmación del pago (webhook). En local no existe salvo
# que uses un túnel (ngrok, etc.) — ver server/README.md.
PAYMENTS_PUBLIC_URL=http://localhost:3001

# --- Servidor de Google Calendar (calendar.js) ---

# Google Cloud Console -> APIs & Services -> Credentials -> tu cliente
# OAuth "Aplicación web" (el mismo que usa el login con Google, ver
# SETUP.md). SECRETO — nunca en el navegador, solo acá.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Puerto donde escucha el servidor de Calendar.
CALENDAR_PORT=3002

# URL pública donde Google puede alcanzar ESTE servidor para el
# callback del OAuth (/oauth-callback) y donde Supabase manda el
# Database Webhook de `turnos` (/webhook-turno). En local no existe
# salvo que uses un túnel (ngrok, etc.) — ver server/README.md.
CALENDAR_PUBLIC_URL=http://localhost:3002
